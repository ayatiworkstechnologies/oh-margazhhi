# Use Apache rewrite engine
RewriteEngine On

# Make sure we are in the correct directory context
RewriteBase /

# 1) Directly serve existing files and folders
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2) Remove .html extension from URLs
# If the requested path without extension exists as .html, serve it.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# 3) Handle "folder style" pages like /about → /about/index.html
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# 4) Optional: custom 404 page
# If you have public_html/404.html
ErrorDocument 404 /404.html
